# Copier ce fichier en .env.local (jamais committé) et renseigner les valeurs
# réelles. Les mêmes secrets que .streamlit/secrets.toml côté app Streamlit
# peuvent être réutilisés -- ne jamais préfixer NEXT_PUBLIC_ un secret serveur.

# URL publique du site -- utilisée pour les redirections d'email Supabase
# (confirmation de compte). En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Supabase -- exposés au client (clé anon uniquement, RLS active côté DB)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase -- serveur uniquement, jamais exposé au client
SUPABASE_SERVICE_ROLE_KEY=

# ScraperAPI -- serveur uniquement
SCRAPER_API_KEY=

# AliExpress Open Platform -- App Key publique (identifiant d'app, pas un
# secret), App Secret et jetons OAuth restent server-only / secrets
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_ACCESS_TOKEN=
ALIEXPRESS_REFRESH_TOKEN=
ALIEXPRESS_AUTH_CODE=
ALIEXPRESS_CALLBACK_URL=

# Stripe -- Payment Links des 5 packs de crédits (publics par nature, conçus
# pour être partagés) -- préfixés NEXT_PUBLIC_ pour être lus depuis les
# boutons d'achat côté client (components/landing/pricing.tsx et
# credit-calculator.tsx)
NEXT_PUBLIC_STRIPE_LINK_STARTER=
NEXT_PUBLIC_STRIPE_LINK_ESSENTIEL=
NEXT_PUBLIC_STRIPE_LINK_AVANCE=
NEXT_PUBLIC_STRIPE_LINK_PRO=
NEXT_PUBLIC_STRIPE_LINK_ULTIMATE=

# Stripe -- clé secrète API + secret de signature webhook, server-only
# (nécessaires uniquement si un webhook /api/stripe/webhook est ajouté pour
# créditer automatiquement les comptes après paiement -- pas encore construit)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe -- clé publique, exposée au client (jamais la clé secrète)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Adresse de destination du formulaire de contact (landing page) --
# exposée au client, ce n'est pas un secret. Sans valeur, retombe sur
# contact@margemax.app.
NEXT_PUBLIC_CONTACT_EMAIL=
