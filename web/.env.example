# Variables d'environnement MargeMax (web/).
#
# Les valeurs déjà renseignées ci-dessous sont PUBLIQUES par nature (clé
# Supabase "publishable", Payment Links Stripe, App Key AliExpress) --
# elles sont conçues pour être exposées et ne sont pas des secrets. Les
# champs laissés vides sont de VRAIS secrets (clé service_role, clé API
# Stripe, Firecrawl, App Secret / jetons AliExpress) : ne les committez
# jamais ici, renseignez-les uniquement dans .env.local (gitignore) en
# local, et dans Vercel -> Project Settings -> Environment Variables en
# production.

# URL publique du site -- utilisée pour les redirections d'email Supabase.
# En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Supabase -- projet MargeMax (clé publishable, RLS active côté DB).
# Projet réinitialisé le 2026-09-17 : nouvelle URL/clé ci-dessous. Le
# schéma (schema_margemax.sql, racine du dépôt) doit être rejoué dans le
# SQL Editor de CE nouveau projet -- une réinitialisation Supabase ne
# conserve ni les tables, ni les triggers, ni les policies RLS.
NEXT_PUBLIC_SUPABASE_URL=https://jduedcsgyylvojltklsg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_NZVnMNYoi4oJ1D2BbnC2pQ_YGjiSnhj

# Supabase -- serveur uniquement (SECRET, jamais exposé au client)
SUPABASE_SERVICE_ROLE_KEY=

# Firecrawl -- serveur uniquement (SECRET), utilisée par app/api/search
# et app/api/analyze (lib/aliexpress-search.ts, partagée entre les deux)
FIRECRAWL_API_KEY=

# AliExpress Open Platform -- App Key publique (identifiant d'app, pas un
# secret). App Secret + jetons OAuth restent des SECRETS server-only.
ALIEXPRESS_APP_KEY=544130
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_ACCESS_TOKEN=
ALIEXPRESS_REFRESH_TOKEN=
ALIEXPRESS_AUTH_CODE=
ALIEXPRESS_CALLBACK_URL=

# Stripe -- Payment Links des 5 packs de crédits (publics, conçus pour être
# partagés avec les clients) -- préfixés NEXT_PUBLIC_ pour être lus côté
# client par components/landing/pricing.tsx et credit-calculator.tsx
NEXT_PUBLIC_STRIPE_LINK_STARTER=https://buy.stripe.com/4gMdRadjd4x677de3O77O03
NEXT_PUBLIC_STRIPE_LINK_ESSENTIEL=https://buy.stripe.com/7sY00k2Ez9RqgHN0cY77O04
NEXT_PUBLIC_STRIPE_LINK_AVANCE=https://buy.stripe.com/00wfZi4MH3t2dvBgbW77O05
NEXT_PUBLIC_STRIPE_LINK_PRO=https://buy.stripe.com/eVq5kEbb5fbK8bh8Ju77O06
NEXT_PUBLIC_STRIPE_LINK_ULTIMATE=https://buy.stripe.com/4gM5kE0wr5Ba77dbVG77O07

# Stripe -- clé secrète API + secret de signature webhook (SECRETS).
# Requis par app/api/webhooks/stripe (credite les comptes apres paiement
# confirme) : sans ces deux valeurs, le webhook refuse toute requête
# (signature invalide / non configuré) -- aucun crédit ne sera jamais
# attribué automatiquement tant qu'elles ne sont pas renseignées dans
# Vercel, ET que l'URL /api/webhooks/stripe n'est pas enregistrée comme
# endpoint dans le Dashboard Stripe (Developers -> Webhooks), écoutant
# au minimum l'événement checkout.session.completed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe -- clé publique (publishable), exposée au client
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Adresse de destination du formulaire de contact -- publique, ce n'est
# pas un secret. Sans valeur, retombe sur contact@autoutilshop.fr.
NEXT_PUBLIC_CONTACT_EMAIL=

# Resend -- serveur uniquement (SECRET), utilisée par app/api/contact pour
# envoyer reellement les messages du formulaire de contact (remplace
# l'ancien systeme mailto:). Sans cette cle, le formulaire affiche un
# message d'erreur clair au lieu d'echouer silencieusement.
RESEND_API_KEY=
# Adresse d'expediteur -- DOIT etre un domaine verifie dans le compte
# Resend (Resend refuse d'envoyer "From" un domaine non verifie). Sans
# valeur, retombe sur le domaine de test onboarding@resend.dev (fonctionne
# sans verification, mais a reserver aux tests, pas a un usage durable en
# production).
RESEND_FROM_EMAIL=
